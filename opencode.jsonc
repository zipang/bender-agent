{
	"$schema": "https://opencode.ai/config.json",
	// OpenCode project configuration for 3D-models (V2).
	// The "bender" agent is the default agent for this project.
	"default_agent": "bender",
	// The OpenAI-compatible endpoint, for a manual chat in /models. The endpoint is external: this
	// repository starts no server. Bender calls the scene drafter script and never this provider.
	"providers": {
		"local": {
			"name": "Local OpenAI-compatible endpoint",
			"package": "@opencode/ai/providers/openai-compatible",
			"settings": { "baseURL": "http://127.0.0.1:9931/v1" },
			"models": { "qwen3.5-4b-3d-coder": { "name": "Qwen 3.5 4B 3D Coder" } },
		},
	},
	"mcp": {
		"servers": {
			// vcad MCP server: local parametric BRep/CSG CAD with a WASM kernel.
			// npx is not installed on this machine, so we use bunx (Bun).
			//"vcad": {
			//	"type": "local",
			//	"command": ["{env:HOME}/.bun/bin/bunx", "@vcad/mcp"],
			//},
			// Blender MCP server: needs Blender with the MCP for Blender add-on running.
			// Absolute path: the OpenCode service does not always inherit the shell PATH.
			"blender": {
				"type": "local",
				"command": ["{env:HOME}/.local/bin/uvx", "mcp-for-blender"],
				"environment": {
					"BLENDER_HOST": "localhost",
					"BLENDER_PORT": "9876",
					"DISABLE_TELEMETRY": "true",
				},
			},
		},
	},
	// A custom formatter runs only for the extensions listed here — OpenCode
	// matches the file's final extension and has no "all files" wildcard. This
	// is the complete set `bun fmt` accepts; unsupported types such as .rs,
	// .sass, .xml and .astro are handled by the built-in formatters instead.
	"formatter": {
		"bun": {
			"command": ["bun", "fmt", "$FILE"],
			"extensions": [
				".js",
				".jsx",
				".mjs",
				".cjs",
				".ts",
				".tsx",
				".mts",
				".cts",
				".css",
				".scss",
				".less",
				".html",
				".htm",
				".vue",
				".svelte",
				".json",
				".jsonc",
				".json5",
				".yaml",
				".yml",
				".toml",
				".md",
				".mdx",
				".graphql",
				".gql",
				".hbs",
				".handlebars",
			],
		},
	},
}
